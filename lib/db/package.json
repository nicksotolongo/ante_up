{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "repair-event-game-duplicates": "tsx src/repairEventGameDuplicates.ts",
    "push": "pnpm run repair-event-game-duplicates && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "pnpm run repair-event-game-duplicates && drizzle-kit push --force --config ./drizzle.config.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
